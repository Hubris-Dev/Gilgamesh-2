# ====================================================
# GILGAMESH-2 — variables d'environnement
# Copie ce fichier en .env et remplis les valeurs
# ========================================================
# Gène-seed (obligatoire en production)
GENESEDG_HASH=

# Base de données
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/gilgamesh?retryWrites=true
MEMOIRE_TTL_JOURS=30

# IA - Kyrven (principal)
KRYVEN_API_KEY=
KRYVEN_BASE_URL=https://api.kryven.com/v1

# IA - Groq (cœur secondaire, obligatoire)
GROQ_API_KEY=

# WhatsApp
BOT_WHATSAPP_NUMBER=1234567890

# Admins (IDs WhatsApp, séparés par des virgules)
ADMIN_IDS=

# Monitoring
POULS_INTERVALLE_MS=30000
DEBUG_SANG=false
